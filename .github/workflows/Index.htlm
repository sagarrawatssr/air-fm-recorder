name: Record AIR FM Rainbow (7 AM - 7 PM IST)

on:
  schedule:
    # 7:00 AM IST is 1:30 AM UTC
    - cron: '30 1 * * *'
  workflow_dispatch: # Allows you to manually click "Run" anytime to test

jobs:
  record_and_slice:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install FFmpeg
        run: sudo apt-get update && sudo apt-get install -y ffmpeg

      - name: Record and Segment Stream into 1-Hour MP3s
        run: |
          mkdir -p output
          DATE_STR=$(date +'%Y-%m-%d')
          echo "Starting recording at 7 AM IST for 12 hours..."
          
          # URL for AIR FM Rainbow Delhi / Mumbai
          STREAM_URL="https://air.pc.cdn.bitgravity.com/air/live/pbaudio001/playlist.m3u8"
          
          # FFmpeg records for 12 hours (43200s) and slices every 3600s (1 hour)
          ffmpeg -reconnect 1 -reconnect_at_eof 1 -reconnect_streamed 1 -reconnect_delay_max 5 \
            -i "$STREAM_URL" \
            -t 43200 \
            -c:a libmp3lame -b:a 64k -ac 1 \
            -f segment -segment_time 3600 -reset_timestamps 1 \
            -strftime 1 "output/${DATE_STR}_hour_%02d.mp3"

      - name: Upload to GitHub Releases (Permanent Free Cloud Storage)
        uses: softprops/action-gh-release@v1
        with:
          tag_name: archive-${{ github.run_id }}
          files: output/*.mp3
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
